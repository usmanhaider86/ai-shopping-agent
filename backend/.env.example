# ── Backend Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in real values.
#   cp .env.example .env

# RapidAPI (real-time-amazon-data)
RAPIDAPI_KEY=
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=shopping_db
MONGODB_COLLECTION=products

# Currency conversion (approximate rates)
PKR_PER_USD=280
INR_PER_USD=83

# CORS – comma-separated list of allowed frontend origins,
# e.g. https://your-app.vercel.app
CORS_ORIGINS=

# RapidAPI result cache – seconds before a cached result expires
CACHE_TTL_SECONDS=3600
# Maximum number of cached search results kept in memory
CACHE_MAX_ENTRIES=200
# Per-IP rate limit for /api/shopping/search (0 disables)
RATE_LIMIT_PER_MINUTE=10
# Cooldown duration in seconds when a data source fails (MongoDB / Playwright scraper)
SOURCE_FAILURE_COOLDOWN_SECONDS=600
